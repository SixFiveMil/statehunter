{
  "manifest_version": 3,
  "name": "StateHunter: In-Browser SPA State & DOM Security Recon",
  "version": "1.0.0",
  "description": "Real-time client-side runtime JS analysis, postMessage auditing, SPA route de-obfuscation, and secret hunting.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "devtools_page": "devtools.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "StateHunter: Open DevTools to inspect",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
